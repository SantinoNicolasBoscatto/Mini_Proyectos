@model TipoCuentaDTO

@{
    ViewData["Title"] = "Crear Tipo Cuenta";
}

<h1>Crear Tipo de Cuenta</h1>
<h5>EJ: Prestamos, Tarjetas de Credito, CC, CA</h5>
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Crear" class="mb-3">
    <div class="mb-3">
        <label>Nombre de la cuenta</label>
        <input type="text" asp-for="NombreCuenta" class="form-control" />
        <span asp-validation-for="NombreCuenta" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-outline-success">Enviar</button>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</form>


@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}